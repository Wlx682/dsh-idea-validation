{
  "name": "dsh-idea-validation",
  "description": "A stateful, human-gated idea validation workflow plugin for DeepSeek Harness",
  "version": "0.7.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test:dedicated": "node scripts/idea-validation-dedicated-regression.mjs",
    "test:smoke": "node scripts/idea-validation-host-contract-smoke.mjs",
    "test": "npm run test:dedicated && node test.mjs && npm run test:smoke"
  },
  "exports": {
    ".": "./index.js",
    "./workflow": "./workflow.js"
  },
  "files": [
    "index.js",
    "workflow.js",
    "runtime.js",
    "preset",
    "scripts",
    "test.mjs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wlx682/dsh-idea-validation.git"
  },
  "bugs": {
    "url": "https://github.com/Wlx682/dsh-idea-validation/issues"
  },
  "homepage": "https://github.com/Wlx682/dsh-idea-validation#readme",
